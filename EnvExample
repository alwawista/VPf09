# Telegram
BOT_TOKEN=

# ProxyAPI (OpenAI-совместимый шлюз)
PROXY_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
CHAT_MODEL=gpt-5-mini-2025-08-07

# Генерация изображений (ProxyAPI, /image в боте)
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=auto

# Память: сколько последних сообщений (user+assistant) хранить в контексте
MEMORY_MAX_MESSAGES=5
MEMORY_FILE=chat_memory.json
PROMPTS_FILE=prompts.json

# Тарифы: proxyapi_pricing.json (парсинг https://proxyapi.ru/pricing )
PRICING_FILE=proxyapi_pricing.json
PRICING_FETCH_ON_START=true

# Запасные тарифы, если модели нет в JSON (₽ за 1M токенов)
CHAT_INPUT_PRICE_RUB_PER_1M=230
CHAT_OUTPUT_PRICE_RUB_PER_1M=1370
IMAGE_INPUT_PRICE_RUB_PER_1M=1520
IMAGE_OUTPUT_PRICE_RUB_PER_1M=9100
IMAGE_IMAGE_INPUT_PRICE_RUB_PER_1M=2430

# Курс USD — данные ЦБ РФ (JSON)
CBR_JSON_URL=https://www.cbr-xml-daily.ru/daily_json.js
